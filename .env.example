NZ_USERNAME=
NZ_PASSWORD=
NZ_STUDENT_ID=
# Безкоштовна реєстрація без картки: console.groq.com
GROQ_API_KEY=
# Безкоштовна реєстрація без картки: aistudio.google.com
GEMINI_API_KEY=
# OVHcloud AI Endpoints — АНОНІМНИЙ доступ, ключ не обов'язковий (2 запити/
# хв на IP без ключа). Лишити порожнім, або взяти ключ на endpoints.ai.cloud.ovh.net
# для вищого ліміту (400/хв).
OVH_AI_ENDPOINTS_ACCESS_TOKEN=
# Безкоштовна реєстрація без картки: z.ai
ZAI_API_KEY=
# Workers AI — реєстрація на dash.cloudflare.com (безкоштовний тір).
# CLOUDFLARE_ACCOUNT_ID видно у правій панелі будь-якої сторінки дашборду;
# CLOUDFLARE_API_TOKEN створюється в My Profile -> API Tokens (права
# "Workers AI: Read" досить).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Telegram-бот (telegram_bot.py). Токен: напиши @BotFather в Telegram ->
# /newbot -> дай імʼя -> скопіюй токен, який він видасть.
TELEGRAM_BOT_TOKEN=
# Твій особистий telegram user_id (не username!) — дізнатись через
# @userinfobot (напиши йому будь-що, він відповість твоїм id). Список через
# кому, якщо треба дозволити кілька людей: 123456789,987654321
TELEGRAM_ALLOWED_USER_IDS=
